/* ===== Grade Helper – Professional Theme ===== */

/* --- Global --- */
QMainWindow {
    background-color: #f5f7fa;
}

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
    color: #2c3e50;
}

/* --- Labels --- */
QLabel {
    font-size: 13px;
    color: #555;
}

QLabel#title_label {
    font-size: 20px;
    font-weight: bold;
    color: #1a1a2e;
    padding: 4px 0;
}

QLabel#file_label {
    font-size: 12px;
    color: #888;
    padding: 6px 10px;
    background-color: #fff;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
}

/* --- Buttons (general) --- */
QPushButton {
    background-color: #4a90d9;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #357abd;
}

QPushButton:pressed {
    background-color: #2c6aaa;
}

/* --- Pick File button --- */
QPushButton#btn_pick {
    background-color: #6c757d;
}

QPushButton#btn_pick:hover {
    background-color: #5a6268;
}

QPushButton#btn_pick:pressed {
    background-color: #4e555b;
}

/* --- Add to Selected --- */
QPushButton#btn_add_selected {
    background-color: #28a745;
}

QPushButton#btn_add_selected:hover {
    background-color: #218838;
}

QPushButton#btn_add_selected:pressed {
    background-color: #1e7e34;
}

/* --- Add to All --- */
QPushButton#btn_add_all {
    background-color: #17a2b8;
}

QPushButton#btn_add_all:hover {
    background-color: #138496;
}

QPushButton#btn_add_all:pressed {
    background-color: #117a8b;
}

/* --- Save & Open --- */
QPushButton#btn_save {
    background-color: #e67e22;
    font-size: 14px;
    padding: 10px 24px;
}

QPushButton#btn_save:hover {
    background-color: #d35400;
}

QPushButton#btn_save:pressed {
    background-color: #c0392b;
}

/* --- SpinBox --- */
QSpinBox {
    background-color: #fff;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #2c3e50;
    min-width: 65px;
    max-width: 80px;
    padding: 0px;
}

QSpinBox:focus {
    border: 1px solid #4a90d9;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

/* --- Spin −/+ buttons --- */
QPushButton#btn_spin {
    background-color: #c0c4cc;
    color: #2c3e50;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    font-size: 18px;
    font-weight: bold;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
}

QPushButton#btn_spin:hover {
    background-color: #a8adb5;
}

QPushButton#btn_spin:pressed {
    background-color: #909399;
}

/* --- Table --- */
QTableWidget {
    background-color: #fff;
    alternate-background-color: #f9fafb;
    border: 1px solid #dcdfe6;
    border-radius: 8px;
    gridline-color: #e8ecf1;
    selection-background-color: #d4e6f9;
    selection-color: #2c3e50;
    font-size: 13px;
}

QTableWidget::item {
    padding: 6px 10px;
}

QHeaderView::section {
    background-color: #3b5998;
    color: white;
    font-weight: bold;
    font-size: 13px;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #2d4373;
}

QHeaderView::section:last {
    border-right: none;
}

/* --- Scroll bars --- */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #c0c4cc;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #909399;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Separator --- */
QFrame#separator {
    background-color: #dcdfe6;
    max-height: 1px;
}
