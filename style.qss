/* ==========================================================================
   Grade Helper – Modern Professional Enterprise Theme
   ========================================================================== */

/* --- Base & Window --- */
QMainWindow {
    background-color: #f8fafc;
}

QWidget#centralWidget {
    background-color: #f8fafc;
}

QWidget {
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #1e293b;
}

/* --- Header Section --- */
QLabel#title_label {
    font-size: 20px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.3px;
    padding: 0;
}

QLabel#subtitle_label {
    font-size: 13px;
    color: #64748b;
    padding-bottom: 2px;
}

QLabel#field_label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
}

/* --- Cards / Containers --- */
QFrame#file_card, QFrame#bonus_card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QFrame#table_card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

/* --- File Picker Display --- */
QLabel#file_label {
    font-size: 12px;
    color: #64748b;
    padding: 6px 12px;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

/* --- Buttons --- */

/* Primary Button (Save & Open) */
QPushButton#btn_primary {
    background-color: #0f172a;
    color: #ffffff;
    border: 1px solid #0f172a;
    border-radius: 7px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QPushButton#btn_primary:hover {
    background-color: #1e293b;
    border-color: #1e293b;
}

QPushButton#btn_primary:pressed {
    background-color: #334155;
    border-color: #334155;
}

QPushButton#btn_primary:disabled {
    background-color: #94a3b8;
    border-color: #94a3b8;
    color: #f1f5f9;
}

/* Secondary Buttons (Browse, Apply to Selected, Apply to All) */
QPushButton#btn_secondary {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 500;
    min-height: 18px;
}

QPushButton#btn_secondary:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
    color: #0f172a;
}

QPushButton#btn_secondary:pressed {
    background-color: #f1f5f9;
    border-color: #64748b;
    color: #0f172a;
}

/* Stepper (- / +) Buttons */
QPushButton#btn_stepper {
    background-color: #f8fafc;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 600;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QPushButton#btn_stepper:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
}

QPushButton#btn_stepper:pressed {
    background-color: #e2e8f0;
    border-color: #64748b;
}

/* --- SpinBox --- */
QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    padding: 0 4px;
}

QSpinBox:focus {
    border: 1px solid #2563eb;
    background-color: #ffffff;
}

/* Hide native up/down buttons */
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

/* --- Table Widget --- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: none;
    border-radius: 7px;
    gridline-color: #f1f5f9;
    selection-background-color: #eff6ff;
    selection-color: #1e40af;
    font-size: 13px;
    outline: none;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f5f9;
}

QTableWidget::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
    font-weight: 600;
}

/* Table Header */
QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #f1f5f9;
}

QHeaderView::section:last {
    border-right: none;
}

/* --- Scroll Bars --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::handle:vertical:pressed {
    background: #64748b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 4px 2px 4px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 36px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 11px;
}
